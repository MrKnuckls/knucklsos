# KnucklsOS v1.1 MINIMAL package list (step 1: prove it boots on real PC).
# Just a KDE desktop + Debian's live-boot. No gaming/branding yet.
kde-plasma-desktop
sddm
live-boot
live-config
live-tools
systemd-sysv
plasma-nm
dolphin
konsole
breeze
kdeconnect
# Firmware: Debian's linux-image pulls linux-firmware; explicit Intel/AMD too.
firmware-linux
firmware-linux-nonfree
firmware-misc-nonfree
firmware-iwlwifi
intel-microcode
amd64-microcode
intel-media-va-driver
# Basic utils
network-manager
curl
wget
ca-certificates
# Branding / splash
plymouth
plymouth-themes
imagemagick
# Installer: Calamares (graphical, Windows-like KDE installer)
calamares
calamares-settings-debian
qml-module-qtquick-controls
qml-module-qtquick-extras
# Bootloader packages Calamares needs to install to HDD (UEFI + Secure Boot)
grub-efi-amd64
grub-efi-amd64-signed
shim-signed
efibootmgr
grub-common
# polkit lets the live user launch the installer without a password
policykit-1
polkitd-pkla
libpolkit-gobject-1-0
sudo
