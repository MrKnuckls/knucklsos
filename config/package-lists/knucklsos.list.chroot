# KnucklsOS package list (Debian live-build: *.list.chroot)
# Debian base + KDE Plasma (Win11-style desktop)
# NOTE: the kernel is installed by live-build itself via --linux-packages
# (set in build.sh), NOT listed here (listing it causes a double-arch name).
kde-plasma-desktop
sddm
plasma-nm
plasma-pa
dolphin
konsole
kdeconnect
breeze
breeze-gtk-theme
papirus-icon-theme
fonts-noto-core
fonts-liberation
# Browser: Google Chrome fetched as a real .deb by hook 0500
# Gaming stack (all available on Debian)
steam-installer
steam-devices
lutris
wine
wine64
gamemode
mangohud
vulkan-tools
mesa-vulkan-drivers
mesa-utils
# NOTE: 32-bit (i386) gaming libraries (wine32, mesa i386, libvulkan/gl i386)
# are installed by hook 1000-i386-gaming.chroot, which enables i386 and pulls
# them in after the main package pass (live-build's bootstrap multiarch timing
# is unreliable on the Ubuntu fork).
# --- CPU + GPU hardware support (Intel i5 / AMD graphics) ---
intel-microcode
amd64-microcode
libgl1-mesa-dri
mesa-va-drivers
libvulkan1
# --- NVIDIA: install the driver from non-free (Debian's reliable path) ---
nvidia-driver
nvidia-detect
# Disk installer (Calamares — Debian's supported, themeable installer)
calamares
calamares-settings-debian
# GPU auto-detect deps
pciutils
polkit-kde-agent-1
# Boot splash + first-boot
plymouth-themes
# Extras
flatpak
gnome-software-plugin-flatpak
unzip
curl
wget
ca-certificates
