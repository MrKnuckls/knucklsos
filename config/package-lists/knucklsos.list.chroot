# KnucklsOS package list (live-build: *.list.chroot)
# Base + desktop
linux-generic
kde-plasma-desktop
sddm
plasma-nm
plasma-pa
dolphin
konsole
kdeconnect
breeze
breeze-gtk-theme
papirus-icon-theme
fonts-noto-core
fonts-liberation
# Browser: Google Chrome is fetched as a real .deb by hook 0500 (avoids the
# Noble chromium snap transitional package, which fails inside a chroot).
# Boot splash + first-boot
plymouth-themes
# Disk installer (Ubuntu's Ubiquity; integrates with live-build --debian-installer live)
ubiquity
ubiquity-frontend-kde
os-prober
# GPU auto-detect deps
ubuntu-drivers-common
pciutils
polkit-kde-agent-1
# Gaming stack
steam
lutris
wine
wine64
wine32:i386
gamemode
mangohud
vulkan-tools
mesa-vulkan-drivers
mesa-vulkan-drivers:i386
mesa-utils
libvulkan1:i386
libgl1:i386
libglx-mesa0:i386
# --- CPU + GPU hardware support (Intel i5 / AMD graphics) ---
# CPU microcode: stability & security fixes for Intel and AMD.
intel-microcode
amd64-microcode
# Mesa open drivers (already cover AMD GPUs and Intel integrated graphics).
libgl1-mesa-dri
mesa-va-drivers
# Vulkan + video accel for AMD and Intel.
libvulkan1

xpad
xboxdrv
# NOTE: NVIDIA driver is NOT baked into the ISO (it's huge and version-specific).
# gpu-detect.sh installs the recommended nvidia-driver on first boot via
# `ubuntu-drivers autoinstall` (needs network on first boot). This keeps the
# ISO smaller and avoids shipping a possibly-wrong driver version.
# Extras
flatpak
gnome-software-plugin-flatpak
unzip
curl
wget
ca-certificates
