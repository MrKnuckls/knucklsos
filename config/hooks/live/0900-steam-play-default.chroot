#!/bin/sh
# KnucklsOS: ensure Steam Play (Proton for all titles) is enabled for any
# EXISTING user who already has a .steam config. New users get the setting for
# free from the /etc/skel seed; this hook covers users created before first boot
# (e.g. the installer-created account) by copying the seed into their profile.
set -e

SEED=/etc/skel/.steam/steam/config/config.vdf
[ -f "$SEED" ] || exit 0

for home in /home/*; do
  [ -d "$home" ] || continue
  user=$(basename "$home")
  [ "$user" = "lost+found" ] && continue
  target="$home/.steam/steam/config/config.vdf"
  if [ -d "$home/.steam/steam/config" ]; then
    if [ ! -f "$target" ] || ! grep -q 'ShowAllGames' "$target"; then
      install -Dm644 "$SEED" "$target"
      chown "$user":"$user" "$target" 2>/dev/null || true
      echo "[KnucklsOS] Steam Play default applied for $user"
    fi
  fi
done
