#!/bin/bash
# KnucklsOS branding - applied via the PROPER mechanisms so it survives login.
# 1) Set the KnucklsOS look-and-feel as the system default (wallpaper + Folder
#    View desktop icons + green accent). /etc/skel alone gets overwritten by KDE
#    on first login, so we use plasma-lookandfeel-tool which writes the real
#    default that every new session inherits.
# 2) Rebuild the initramfs WITH plymouth so the splash actually shows at boot.
# 3) Drop the installer icon on the desktop (Folder View shows it).
set -e

ASSETS=/usr/share/knucklsos/assets

# --- 1) Apply look-and-feel as default ---
if command -v plasma-lookandfeel-tool >/dev/null 2>&1; then
  plasma-lookandfeel-tool --apply org.knucklsos.desktop 2>/dev/null || true
fi
# Also set it as the global default for SDDM/new users via a profile script
mkdir -p /etc/profile.d
cat > /etc/profile.d/knucklsos-lookandfeel.sh <<'EOF'
# Ensure the KnucklsOS look-and-feel is the default for any session that starts
if command -v plasma-lookandfeel-tool >/dev/null 2>&1; then
  plasma-lookandfeel-tool --apply org.knucklsos.desktop >/dev/null 2>&1 || true
fi
EOF

# --- 2) Plymouth splash: rebuild initramfs with the theme image ---
mkdir -p /usr/share/plymouth/themes/knucklsos
# plymouth needs a PNG; convert the jpg
if [ -f "$ASSETS/knuckls-fist.jpg" ]; then
  if command -v convert >/dev/null 2>&1; then
    convert "$ASSETS/knuckls-fist.jpg" /usr/share/plymouth/themes/knucklsos/knuckls-fist.png 2>/dev/null || \
      cp "$ASSETS/knuckls-fist.jpg" /usr/share/plymouth/themes/knucklsos/knuckls-fist.png
  else
    cp "$ASSETS/knuckls-fist.jpg" /usr/share/plymouth/themes/knucklsos/knuckls-fist.png
  fi
fi
# Set default theme and rebuild initramfs against the installed kernel
plymouth-set-default-theme -R knucklsos 2>/dev/null || plymouth-set-default-theme knucklsos 2>/dev/null || true
# Force the initramfs rebuild (live-build regenerates later, but this seeds it)
LK=$(ls /boot/vmlinuz-* 2>/dev/null | head -1)
if [ -n "$LK" ]; then
  KVER=$(echo "$LK" | sed 's#.*vmlinuz-##')
  update-initramfs -u -k "$KVER" 2>/dev/null || update-initramfs -u 2>/dev/null || true
fi

# --- 3) Installer icon on the desktop (launches passwordless as root) ---
cat > /usr/share/applications/knucklsos-install.desktop <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=Install KnucklsOS
Comment=Install KnucklsOS to this computer
Exec=sudo calamares
Icon=$ASSETS/knuckls-fist.jpg
Terminal=false
Categories=System;
EOF
mkdir -p /etc/skel/Desktop
cp /usr/share/applications/knucklsos-install.desktop /etc/skel/Desktop/
chmod +x /etc/skel/Desktop/knucklsos-install.desktop

# Passwordless sudo for the live user so the installer launches without a prompt
echo "knucklsos ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/knucklsos
chmod 440 /etc/sudoers.d/knucklsos

# Also place the icon in the live user's home if it already exists
if [ -d /home/knucklsos ]; then
  mkdir -p /home/knucklsos/Desktop
  cp /usr/share/applications/knucklsos-install.desktop /home/knucklsos/Desktop/ 2>/dev/null || true
  chmod +x /home/knucklsos/Desktop/knucklsos-install.desktop 2>/dev/null || true
fi

# --- 4) Calamares: override bootloader.conf to force EFI grub + shim ---
# (calamares-settings-debian provides the rest: unpackfs/fstab/sequence.)
mkdir -p /etc/calamares/modules
cat > /etc/calamares/modules/bootloader.conf <<'EOF'
---
# EFI-only bootloader. We ship grub-efi-amd64-signed + shim-signed in the ISO,
# so the install works on UEFI/Secure-Boot machines. BIOS (grub-pc) is NOT used.
efiBootLoader: "grub"

# Debian kernel/initramfs paths
kernel: "/vmlinuz"
img: "/initrd.img"
timeout: "10"

grubInstall: "grub-install"
grubMkconfig: "grub-mkconfig"
grubCfg: "/boot/grub/grub.cfg"
grubProbe: "grub-probe"
efiBootMgr: "efibootmgr"
installEFIFallback: true
EOF

# --- 5) Calamares packages.conf: only purge packages that are actually
# installed. The Debian default lists live-task-* which we don't ship, and
# apt fails (code 100) trying to purge missing packages -> "Package Manager
# error". Rewrite with only the live packages present in our image.
cat > /etc/calamares/modules/packages.conf <<'EOF'
backend: apt

operations:
  - remove:
      - 'live-boot'
      - 'live-boot-doc'
      - 'live-config'
      - 'live-config-doc'
      - 'live-config-systemd'
      - 'live-tools'
      - 'calamares'
      - 'calamares-settings-debian'
EOF

echo "KnucklsOS branding applied (look-and-feel default + plymouth + installer icon + EFI bootloader cfg + packages cleanup)"
