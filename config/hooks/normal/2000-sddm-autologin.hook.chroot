#!/bin/bash
# Writes SDDM startup-delay config AFTER packages install, so it survives
# SDDM's postinst (includes.chroot files get overwritten otherwise).
# NOTE: we deliberately do NOT set a hardcoded [Autologin] User=knucklsos here.
# On the live USB, autologin is handled by live-config (username=knucklsos boot
# param). On the INSTALLED system Calamares creates the user YOU chose, so a
# hardcoded knucklsos autologin would point at a nonexistent user and black-screen.
# The 3s sleep is the real fix for the SDDM/Plasma black-screen race.
set -e

mkdir -p /etc/systemd/system/sddm.service.d
cat > /etc/systemd/system/sddm.service.d/override.conf <<'EOF'
[Service]
# Workaround for the SDDM/Plasma black-screen race: SDDM can start before the
# GPU/KWin is ready, leaving a black screen. Delay SDDM briefly.
ExecStartPre=/bin/sleep 3
EOF

echo "knucklsos SDDM delay config written"
