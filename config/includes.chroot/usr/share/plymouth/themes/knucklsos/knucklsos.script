# KnucklsOS Plymouth boot splash script
# Background matches the logo's solid #0a1a3f so it blends seamlessly.
Window.SetBackgroundTopColor(0.039, 0.102, 0.247);
Window.SetBackgroundBottomColor(0.039, 0.102, 0.247);

logo = Image("knucklsos-logo.png");
logo_sprite = Sprite(logo);
logo_sprite.SetPosition(Window.GetWidth() / 2 - logo.GetWidth() / 2,
                        Window.GetHeight() / 2 - logo.GetHeight() / 2 - 20, 0);

# Thin progress bar that fills as boot advances.
bar_w = 240;
bar_h = 4;
bar = Image(bar_w, bar_h);
for (x = 0; x < bar_w; x++) {
    for (y = 0; y < bar_h; y++) {
        bar[x, y] = 1.0, 1.0, 1.0, 0.9;
    }
}
bar_sprite = Sprite(bar);
bar_sprite.SetPosition(Window.GetWidth() / 2 - bar_w / 2,
                       Window.GetHeight() / 2 + logo.GetHeight() / 2 + 14, 0);
bar_sprite.SetOpacity(0.0);

Plymouth.SetBootProgressFunction(fun(fraction, duration) {
    bar_sprite.SetOpacity(0.2 + 0.8 * fraction);
});
