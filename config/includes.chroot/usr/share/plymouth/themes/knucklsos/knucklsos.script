# KnucklsOS Plymouth splash - Windows 11 style: "KNUCKLS OS" wordmark centered
# with a rotating spinner ring, on a near-black background.

Window.SetBackgroundAlpha(1)
Window.SetBackgroundTopColor(0.02, 0.02, 0.04)
Window.SetBackgroundBottomColor(0.02, 0.02, 0.04)

# --- Wordmark (KNUCKLS OS) centered, slightly above middle ---
logo = Image.New(ImageDir + "/knucklsos-wordmark.png")
scale = Window.GetWidth() * 0.42 / logo.GetWidth()
logo = logo.Scale(int(logo.GetWidth() * scale), int(logo.GetHeight() * scale))
logo_pos_x = Window.GetWidth() / 2 - logo.GetWidth() / 2
logo_pos_y = Window.GetHeight() / 2 - logo.GetHeight() / 2 - 60
logo_sprite = Sprite.New(logo)
logo_sprite.SetPosition(logo_pos_x, logo_pos_y)

# --- Spinner ring (faint track + bright rotating arc) ---
track_img = Image.New(ImageDir + "/knucklsos-spinner-track.png")
track_sprite = Sprite.New(track_img)
arc_img = Image.New(ImageDir + "/knucklsos-spinner-arc.png")
arc_sprite = Sprite.New(arc_img)

ring_cx = Window.GetWidth() / 2
ring_cy = logo_pos_y + logo.GetHeight() + 90
track_sprite.SetPosition(ring_cx - track_img.GetWidth() / 2, ring_cy - track_img.GetHeight() / 2)
arc_sprite.SetPosition(ring_cx - arc_img.GetWidth() / 2, ring_cy - arc_img.GetHeight() / 2)

angle = 0
fun refresh_callback()
    angle = angle + 8
    if angle >= 360 then angle = angle - 360 end
    arc_sprite.SetRotation(angle)
    return true
end

Plymouth.MainLoopAddTimer(16, refresh_callback)

fun quit_callback(time)
    logo_sprite.SetOpacity(0)
    arc_sprite.SetOpacity(0)
    track_sprite.SetOpacity(0)
end

Plymouth.SetQuitFunction(quit_callback)
