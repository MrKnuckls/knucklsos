# KnucklsOS Plymouth splash - shows the neon fist logo + a progress bar.
# Background: near-black. Logo: knuckls-fist.png centered.

Window.SetBackgroundAlpha(1)
Window.SetBackgroundTopColor(0.02, 0.02, 0.04)
Window.SetBackgroundBottomColor(0.02, 0.02, 0.04)

logo = Image.New(ImageDir + "/knuckls-fist.png")
logo = logo.Scale(logo.GetWidth() * 0.5, logo.GetHeight() * 0.5)
logo_pos_x = Window.GetWidth() / 2 - logo.GetWidth() / 2
logo_pos_y = Window.GetHeight() / 2 - logo.GetHeight() / 2 - 20
logo_sprite = Sprite.New(logo)
logo_sprite.SetPosition(logo_pos_x, logo_pos_y)

# Neon green progress bar
bar_width = Window.GetWidth() * 0.45
bar_height = 6
bar_x = Window.GetWidth() / 2 - bar_width / 2
bar_y = logo_pos_y + logo.GetHeight() + 30

bar_bg = Rectangle.New(bar_width, bar_height, 0.1, 0.1, 0.1)
bg_sprite = Sprite.New(bar_bg)
bg_sprite.SetPosition(bar_x, bar_y)

bar = Rectangle.New(1, bar_height, 0.2, 1.0, 0.2)
bar_sprite = Sprite.New(bar)
bar_sprite.SetPosition(bar_x, bar_y)

fun progress_callback(value, time)
    bar_sprite.SetX(bar_x)
    bar_sprite.SetWidth(bar_width * value)
end

fun quit_callback(time)
    # fade out
    logo_sprite.SetOpacity(0)
    bg_sprite.SetOpacity(0)
    bar_sprite.SetOpacity(0)
end

Plymouth.SetBootProgressFunction(progress_callback)
Plymouth.SetQuitFunction(quit_callback)
